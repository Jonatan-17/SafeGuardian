  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "roadguardian-analyze",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "fffcd4c2-c563-4d3e-b665-47d7fd76cef1",
      "name": "Webhook RoadGuardian",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        2736,
        1248
      ],
      "webhookId": "roadguardian-analyze"
    },
    {
      "parameters": {
        "jsCode": "\n// Payload real enviado por SafeGuardian (app.js -> sendToN8NWebhook -> generatePayload)\nconst body = $json.body || $json;\n\nconst required = ['driver', 'vehicle', 'route', 'analysis', 'alert', 'timestamp'];\nconst missing = required.filter(k => body[k] === undefined || body[k] === null);\n\nif (missing.length > 0) {\n  throw new Error('Validación fallida. Campos faltantes: ' + missing.join(', '));\n}\nif (!body.driver.id) {\n  throw new Error('Validación fallida. driver.id es obligatorio');\n}\n\nreturn [{ json: body }];\n"
      },
      "id": "1fcb0af3-570b-4a28-8f35-580741a93fa2",
      "name": "Validación Entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        2960,
        1248
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.recentEvents) staticData.recentEvents = {};\n\nconst item = $input.first().json;\nconst key = `${item.driver.id}_${item.alert.type}_${item.alert.severity}`;\nconst now = Date.now();\nconst WINDOW_MS = 15000; // 15s anti-flood\n\nconst last = staticData.recentEvents[key];\nif (last && (now - last) < WINDOW_MS) {\n  return []; // descarta duplicado -> corta el flujo\n}\n\nstaticData.recentEvents[key] = now;\nreturn [{ json: item }];\n"
      },
      "id": "26ac932f-2864-40b7-8280-2c6725ea1bc1",
      "name": "Control Duplicados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        3184,
        1248
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.rateLimit) staticData.rateLimit = {};\n\nconst item = $input.first().json;\nconst driver = item.driver.id;\nconst now = Date.now();\nconst WINDOW_MS = 60000; // 1 min\nconst MAX_EVENTS = 10;\n\nif (!staticData.rateLimit[driver]) staticData.rateLimit[driver] = [];\nstaticData.rateLimit[driver] = staticData.rateLimit[driver].filter(t => now - t < WINDOW_MS);\n\nif (staticData.rateLimit[driver].length >= MAX_EVENTS) {\n  throw new Error(`Rate limit excedido para driver_id=${driver}`);\n}\n\nstaticData.rateLimit[driver].push(now);\nreturn [{ json: item }];\n"
      },
      "id": "e6ad9f35-dba6-4307-ac0c-a69bba00436b",
      "name": "Rate Limiting",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        3408,
        1248
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst item = $input.first().json;\n\nconst yolo = item.analysis.model_yolo || { detections: [] };\nconst voxel = item.analysis.model_voxel51 || { labels: [], severity_score: 0 };\nconst alert = item.alert || {};\n\nconst detections = yolo.detections || [];\nconst avgConfidence = detections.length\n  ? detections.reduce((a, d) => a + (d.confidence || 0), 0) / detections.length\n  : 0.5;\n\n// risk_factors derivados de las labels de Voxel51 + clases YOLO\nconst riskFactors = [...new Set([\n  ...(voxel.labels || []),\n  ...detections.map(d => d.class)\n])];\n\nconst normalized = {\n  driver_id: item.driver.id,\n  driver_name: item.driver.name,\n  vehicle_plate: item.vehicle.plate,\n  timestamp: item.timestamp,\n  source: item.event_origin || 'safeguardian_webapp',\n  incident_type: alert.type || 'unknown',\n  risk_factors: riskFactors,\n  confidence: Number(avgConfidence.toFixed(2)),\n  severity: alert.severity || 'INFO',\n  voxel_score: voxel.severity_score || 0,\n  risk_score: 0, // se calcula en Motor de Riesgo\n  summary: alert.message || '',\n  sector: item.route.sector || item.route.name,\n  coordinates: item.route.current_coordinates || {},\n  raw: item\n};\n\nreturn [{ json: normalized }];\n"
      },
      "id": "9fb197fd-915a-47d9-b310-095e1e0ae3a0",
      "name": "Normalización JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        3616,
        1248
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst item = $input.first().json;\n\nconst weights = { fatiga: 0.35, distraccion: 0.30, incidente: 0.20, confianza: 0.15 };\n\nconst fatigueKeywords = ['drowsiness', 'eyes_closed', 'fatigue', 'head_tilt'];\nconst distractionKeywords = ['distraction', 'no_helmet', 'pedestrian', 'collision', 'phone'];\n\nconst fatigueScore = item.risk_factors.some(f => fatigueKeywords.some(k => f.includes(k))) ? 100 : 0;\nconst distractionScore = item.risk_factors.some(f => distractionKeywords.some(k => f.includes(k))) ? 100 : 0;\n\n// Severidad reportada por Voxel51/alert ya trae un veredicto -> mapeo directo\nconst severityMap = { CRITICAL: 100, WARNING: 60, INFO: 10 };\nconst incidentScore = severityMap[item.severity] ?? (item.voxel_score * 10);\n\nconst confidenceScore = item.confidence * 100;\n\nlet riskScore =\n  fatigueScore * weights.fatiga +\n  distractionScore * weights.distraccion +\n  incidentScore * weights.incidente +\n  confidenceScore * weights.confianza;\n\n// Si Voxel51 ya marcó CRITICAL, garantizamos que cruce el umbral de alerta\nif (item.severity === 'CRITICAL') {\n  riskScore = Math.max(riskScore, 75);\n}\n\nitem.risk_score = Math.round(riskScore);\nreturn [{ json: item }];\n"
      },
